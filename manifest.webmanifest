{
  "name": "Rutenda · Tu viaje, paso a paso",
  "short_name": "Rutenda",
  "description": "Organizá tu viaje paso a paso: pasajes, alojamiento, documentos, valija y gastos compartidos.",
  "lang": "es-AR",
  "start_url": "./index.html#inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F1E8",
  "theme_color": "#1F3A36",
  "icons": [
    {
      "src": "assets/icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icono-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icono-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "shortcuts": [
    {
      "name": "Cargar un gasto",
      "short_name": "Gasto",
      "description": "Cargá un gasto, un documento o algo para la valija",
      "url": "./index.html#cargar",
      "icons": [
        {
          "src": "assets/icono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Hoy en el viaje",
      "short_name": "Hoy",
      "url": "./index.html#hoy",
      "icons": [
        {
          "src": "assets/icono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Itinerario",
      "short_name": "Itinerario",
      "url": "./index.html#itinerario",
      "icons": [
        {
          "src": "assets/icono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivos",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}